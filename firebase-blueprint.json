{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Information about a registered or guest user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "ConversionRecord": {
      "title": "ConversionRecord",
      "description": "User conversion record logged for recent activity",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "toolId": { "type": "string" },
        "toolName": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "outputName": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "toolId", "fileName", "outputName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/users/{userId}/conversions/{conversionId}": {
      "schema": "ConversionRecord",
      "description": "User conversion history documents"
    }
  }
}
